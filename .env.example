# Copy to .env or .env.local and configure. Never commit real private keys or secrets.

# --- Network Selection ---
# "testnet" (default, Chain ID 97) or "mainnet" (Chain ID 56). See src/config/networks.ts.
VITE_CHAIN_ENV="testnet"

# --- 8004scan API Endpoint ---
# Public decentralized ERC-8004 indexer endpoint
VITE_8004SCAN_API_URL="https://8004scan.io/api/v1"

# --- Optional Server-Side BSC Testnet Signer (Node.js Runner Only) ---
# Used strictly by server-side testnet verification scripts in Node.js >=20.
# NEVER expose in client bundles or prefix with VITE_.
# AGENTFLOW_TESTNET_SIGNER_KEY="0x..."
